# =============================================================================
# fabric-ai-project-agent - line ending and diff policy
# =============================================================================
# Text files are normalised to LF inside Git. Microsoft Fabric writes LF for
# notebook payloads and .platform descriptors, but CRLF for some item metadata
# files, so Fabric-owned metadata is exempted from conversion (see the Fabric
# section at the end of this file).
#
# Two further deliberate exceptions are declared below:
#   - customers.csv  : byte-for-byte preservation (UTF-8 BOM + CRLF) because
#                      the Data Quality specification documents its exact
#                      physical profile;
#   - *.ipynb        : already stored with LF; marked explicitly so the JSON
#                      structure is never rewritten by an EOL conversion.
# =============================================================================

# --- Default: normalise every detected text file to LF inside Git ------------
* text=auto eol=lf

# --- Documentation and governance artifacts ----------------------------------
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.py        text eol=lf
*.sql       text eol=lf
*.txt       text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# --- Notebooks ---------------------------------------------------------------
# LF enforced, JSON structure untouched. No merge driver is declared: a
# conflicting notebook must be resolved by regenerating it from the governed
# sources, never by a textual merge of JSON.
*.ipynb     text eol=lf

# --- Source data: preserve bytes exactly -------------------------------------
# "-text" disables all EOL conversion. use_cases/distribution/data/customers.csv
# is profiled in generated/customers_data_quality.md as 39 542 bytes, UTF-8 BOM,
# 509 CRLF terminated lines. Normalising it would invalidate that evidence.
*.csv       -text

# --- Binary ------------------------------------------------------------------
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.pdf       binary
*.xlsx      binary
*.parquet   binary
*.zip       binary

# --- Fabric-managed artifacts (see fabric/README.md) -------------------------
# Serialised Fabric items are written by Microsoft Fabric Git integration.
fabric/**   text eol=lf linguist-generated=true

# Fabric commits item metadata through its Git integration API, which bypasses
# local EOL normalisation. Observed on 2026-10-09: alm.settings.json is stored
# with CRLF while .platform and notebook-content.py are stored with LF. Forcing
# eol=lf on Fabric-owned metadata produces a permanent phantom diff (46 changed
# lines on a byte-identical file). "-text" disables all conversion so Git keeps
# exactly the bytes Fabric sends, in both directions.
fabric/**/*.platform            -text
fabric/**/alm.settings.json     -text
fabric/**/*.metadata.json       -text

# notebook-content.py is the executable source of truth and is edited in
# VS Code: LF stays enforced so a Windows editor cannot inject CRLF into a
# payload that Fabric round-trips.
fabric/**/notebook-content.py   text eol=lf
