# =============================================================================
# fabric-ai-project-agent - line ending and diff policy
# =============================================================================
# Microsoft Fabric writes LF. Git must therefore store LF for every text file,
# otherwise Fabric Git integration produces whole-file diffs on every sync.
#
# Two deliberate exceptions are declared below:
#   - customers.csv  : byte-for-byte preservation (UTF-8 BOM + CRLF) because
#                      the Data Quality specification documents its exact
#                      physical profile;
#   - *.ipynb        : already stored with LF; marked explicitly so the JSON
#                      structure is never rewritten by an EOL conversion.
# =============================================================================

# --- Default: normalise every detected text file to LF inside Git ------------
* text=auto eol=lf

# --- Documentation and governance artifacts ----------------------------------
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.py        text eol=lf
*.sql       text eol=lf
*.txt       text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# --- Notebooks ---------------------------------------------------------------
# LF enforced, JSON structure untouched. No merge driver is declared: a
# conflicting notebook must be resolved by regenerating it from the governed
# sources, never by a textual merge of JSON.
*.ipynb     text eol=lf

# --- Source data: preserve bytes exactly -------------------------------------
# "-text" disables all EOL conversion. use_cases/distribution/data/customers.csv
# is profiled in generated/customers_data_quality.md as 39 542 bytes, UTF-8 BOM,
# 509 CRLF terminated lines. Normalising it would invalidate that evidence.
*.csv       -text

# --- Binary ------------------------------------------------------------------
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.pdf       binary
*.xlsx      binary
*.parquet   binary
*.zip       binary

# --- Fabric-managed artifacts (folder not created yet, see README.md) --------
# Serialised Fabric items are generated by Microsoft Fabric, not hand-written.
fabric/**   text eol=lf linguist-generated=true
